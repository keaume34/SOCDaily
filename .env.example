# SOCDaily LLM configuration
# Copy this file to .env and fill in your values.

# Provider: "openai" (OpenAI-compatible — works for OpenAI, local LM Studio,
# Ollama, vLLM, OpenRouter, DeepInfra, Together, etc.) or "anthropic" (native).
SOCDAILY_LLM_PROVIDER=openai

# Base URL of the LLM API endpoint.
#   OpenAI:           https://api.openai.com/v1
#   LM Studio local:  http://localhost:1234/v1
#   Ollama local:     http://localhost:11434/v1
#   vLLM local:       http://localhost:8000/v1
#   OpenRouter:       https://openrouter.ai/api/v1
#   Anthropic:        https://api.anthropic.com   (leave default if unsure)
SOCDAILY_LLM_BASE_URL=https://api.openai.com/v1

# API key. For local servers that don't check keys, set any non-empty string.
SOCDAILY_LLM_API_KEY=sk-replace-me

# Model name. Leave empty to auto-pick the first available chat model from
# the provider's /models endpoint. Or run `socdaily models` to list options.
# Examples:
#   gpt-4o-mini
#   claude-3-5-sonnet-latest
#   meta-llama/Meta-Llama-3.1-8B-Instruct   (local)
SOCDAILY_LLM_MODEL=

# Optional: extra HTTP header for Anthropic-style auth via OpenAI-compatible
# proxy (rarely needed). Leave empty unless your proxy requires it.
SOCDAILY_LLM_EXTRA_HEADERS=

# Tuning
SOCDAILY_LLM_TEMPERATURE=0.2
SOCDAILY_LLM_MAX_TOKENS=4096

# Language for generated content: "vi", "en", or "bilingual".
SOCDAILY_CONTENT_LANG=vi
